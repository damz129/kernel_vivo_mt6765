CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/damz129/kernel_vivo_mt6765
KERNEL_SOURCE_BRANCH=master
KERNEL_CONFIG=PD2036F_EX_KSU_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS:LD=ld.lld

# Clang
## Custom
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

### if your set USE CUSTOM CLANG to false than DO NOT CHANGE CUSTOM CMDS
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

## AOSP
CLANG_BRANCH=android11-mainline-release
CLANG_VERSION=r383902

# GCC
## AOSP
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
## GCC Custom
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# KernelSU Next flags
ENABLE_KERNELSU=true
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
COMPAT_FIX=true
# KERNELSU_TAG=legacy

# Configuration
DISABLE-LTO=true
DISABLE_CC_WERROR=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
APPLY_KSU_PATCH=false
REMOVE_UNUSED_PACKAGES=true

# AnyKernel3
ENABLE_ANYKERNEL3=false
## AnyKernel3 Custom
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# Ccache
ENABLE_CCACHE=true

# DTBO image
NEED_DTBO=false

# Build DTB
### Only for build DTB action 
NAME_DTB=k65v1_64_bsp_PD2036F_EX.dtb

# Build boot images
BUILD_BOOT_IMG=false
LFS=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/damz129/KernelSU_Next_Action/main/boot/boot.img

# Test config area
RULE_SELINUX=true
MANUAL_KSU_HOOK=true
